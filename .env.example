# DagsHub MLflow Tracking Configuration
# Copy this file to .env and replace placeholders with your credentials:
# cp .env.example .env

MLFLOW_TRACKING_URI=https://dagshub.com/Rishi799/health-wellness-mlops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token
MLFLOW_EXPERIMENT_NAME=cardiometabolic-model-comparison

# Grafana admin password (used by docker-compose.yml)
# IMPORTANT: Replace this placeholder with a real password before running.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING
